<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <TargetExt>.rhp</TargetExt>
    <AssemblyName>ResCodeShadows</AssemblyName>
    <RootNamespace>ResCodeShadows</RootNamespace>
    <LangVersion>8.0</LangVersion>
    <Version>1.0.0</Version>
    <Title>ResCode Shadows</Title>
    <Company>March Studio</Company>
    <Description>Revit-style shadow diagrams and ResCode (Clause 54.04-5 / 55.04-5) overshadowing checks for Rhino.</Description>
    <NoWarn>NU1701</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- RhinoCommon 7 API surface: the plug-in loads in Rhino 7 and Rhino 8. -->
    <PackageReference Include="Clipper2" Version="1.4.0" />
    <PackageReference Include="RhinoCommon" Version="7.13.21348.13001" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so the .rhp works on its own (resolved at runtime in PlugIn.cs). -->
    <EmbeddedResource Include="$(NuGetPackageRoot)clipper2/1.4.0/lib/netstandard2.0/Clipper2Lib.dll" LogicalName="Embedded.Clipper2Lib.dll" Visible="false" />
  </ItemGroup>

</Project>
